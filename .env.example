# Ejemplo para runserver local. Copiar a .env y adaptar sin versionar .env.
# Opcional en desarrollo; obligatorio cuando DJANGO_DEBUG=False.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Opcional para orígenes adicionales; no es necesario para la misma URL local.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
# Estáticos: /static/ y staticfiles/ son los valores predeterminados.
DJANGO_STATIC_URL=/static/
# DJANGO_STATIC_ROOT=staticfiles
# En debug local, MEDIA_ROOT usa media/ dentro del proyecto por defecto.
# DJANGO_MEDIA_ROOT=media

# PostgreSQL: DB_ENGINE, DB_NAME, DB_USER y DB_PASSWORD son obligatorios.
# DB_PASSWORD debe establecerse en .env con la contraseña local del rol.
DB_ENGINE=postgresql
DB_NAME=docu_postgres_dev
DB_USER=docu_postgres_dev_user
DB_PASSWORD=
# Opcionales; los valores siguientes coinciden con el ejemplo local del README.
DB_HOST=127.0.0.1
DB_PORT=5432
# Debe ser diferente de DB_NAME; se usa solo al ejecutar la suite de pruebas.
DB_TEST_NAME=test_docu_postgres_dev

# Opcionales: límites en bytes (20 MiB por PDF, 1 MiB por firma de perfil).
# DOCUMENTO_MAX_FILE_SIZE=20971520
# FIRMA_PERFIL_MAX_FILE_SIZE=1048576

# Correo: variables disponibles para infraestructura futura. El MVP no envía
# verificación ni notificaciones; en debug usa el backend de consola por defecto.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@adicla.org.gt

# Despliegue futuro en cPanel (no operativo en esta entrega): sustituir rutas,
# dominio y secretos según el hosting; media debe quedar fuera del directorio
# público. Con DJANGO_DEBUG=False estos valores de ruta son obligatorios.
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=testing.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://testing.example.com
# DJANGO_STATIC_ROOT=/home/cpanel-user/public_html/static
# DJANGO_PUBLIC_ROOT=/home/cpanel-user/public_html
# DJANGO_MEDIA_ROOT=/home/cpanel-user/private/media
