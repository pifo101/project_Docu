# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=testing.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://testing.example.com

# SQL Server
DB_ENGINE=mssql
DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=replace-with-the-database-password
DB_HOST=sqlserver.example.com
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=no

# Email (SMTP en despliegue; usa backend de consola para desarrollo local)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_VERIFICATION_TIMEOUT=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN=300
