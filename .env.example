# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=testing.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://testing.example.com

# PostgreSQL
DB_ENGINE=postgresql
DB_NAME=docu_postgres_dev
DB_USER=docu_postgres_dev_user
DB_PASSWORD=replace-with-the-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_TEST_NAME=test_docu_postgres_dev

# Infraestructura opcional para futuras funcionalidades; el MVP no envía correos
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
